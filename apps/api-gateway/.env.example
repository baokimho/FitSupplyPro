# Development Compose example. See README Configuration for host overrides.
# Runtime (optional; values shown are defaults)
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Internal authentication (required; must match downstream services)
GATEWAY_SECRET=change-me-for-local-development

# Downstream services (optional; Compose overrides localhost runtime defaults)
# AUTH_SERVICE_URL also controls JWKS retrieval.
AUTH_SERVICE_URL=http://auth-service:3001
CATALOG_SERVICE_URL=http://catalog-service:3002
INVENTORY_SERVICE_URL=http://inventory-service:3004
ORDER_SERVICE_URL=http://order-service:3003
CART_SERVICE_URL=http://cart-service:3005
PAYMENT_SERVICE_URL=http://payment-service:3006
SHIPPING_SERVICE_URL=http://shipping-service:3007
NOTIFICATION_SERVICE_URL=http://notification-service:3008
