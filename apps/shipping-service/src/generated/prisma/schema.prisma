generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Shipment {
  id             String         @id @default(uuid())
  userId         String
  orderId        String
  status         ShipmentStatus @default(PENDING)
  recipientName  String
  phone          String
  addressLine1   String
  addressLine2   String?
  city           String
  postalCode     String
  country        String
  trackingNumber String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([orderId])
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
