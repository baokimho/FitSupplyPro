generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Payment {
  id                String          @id @default(uuid())
  userId            String
  orderId           String
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("USD")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(MOCK)
  providerPaymentId String?
  progressState     String          @default("CREATED")
  pendingOperation  String?
  failureCode       String?
  orderConfirmedAt  DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@unique([orderId])
  @@unique([providerPaymentId])
}

model PaymentIdempotency {
  id                 String   @id @default(uuid())
  userId             String
  action             String
  idempotencyKey     String
  requestFingerprint String
  status             String
  paymentId          String?
  responseBody       Json?
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, action, idempotencyKey])
  @@index([paymentId])
}

// Independent fake provider receipts survive a failed Payment transaction.
model FakeProviderOperation {
  idempotencyKey     String   @id
  requestFingerprint String
  result             String
  reference          String   @unique
  createdAt          DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MOCK
}
