# Development Compose example. See README Configuration for host overrides and keys.
# Runtime (optional; values shown are defaults)
PORT=3001
NODE_ENV=development

# Database (required; local credentials only)
DATABASE_URL=postgresql://fitsupply:change-me-for-local-development@postgres:5432/auth_db
# Optional Prisma tooling only; omit unless using a separate shadow database.
# SHADOW_DATABASE_URL=postgresql://fitsupply:change-me-for-local-development@postgres:5432/auth_shadow_db

# Internal authentication (required; must match all communicating services)
GATEWAY_SECRET=change-me-for-local-development

# RSA keys (both required via env or files; never commit private key material)
# Env values are single-line base64 of UTF-8 JWK JSON, not PEM.
# Omit each variable to use its keys/private.json or keys/public.json fallback.
# Paths are relative to process.cwd(); development Compose does not mount key files.
# JWT_PRIVATE_KEY_BASE64=<base64-encoded-private-JWK>
# JWT_PUBLIC_KEY_BASE64=<base64-encoded-public-JWK>
