# Development Compose example. See README Configuration for host overrides.
# Runtime (optional; values shown are defaults)
NODE_ENV=development
LOG_LEVEL=info
PORT=3003

# Database (required; local credentials only)
DATABASE_URL=postgresql://fitsupply:change-me-for-local-development@postgres:5432/order_db
# Optional Prisma tooling only; omit unless using a separate shadow database.
# SHADOW_DATABASE_URL=postgresql://fitsupply:change-me-for-local-development@postgres:5432/order_shadow_db

# Internal authentication (required; must match communicating services)
GATEWAY_SECRET=change-me-for-local-development

# Downstream services (optional; values shown are runtime defaults)
CATALOG_SERVICE_URL=http://catalog-service:3002
INVENTORY_SERVICE_URL=http://inventory-service:3004
CART_SERVICE_URL=http://cart-service:3005

# Enable together on Order, Inventory and Payment. Broker also publishes sync lifecycle notifications.
EVENT_DRIVEN_CHECKOUT=false
RABBITMQ_URL=amqp://fitsupply:change-me-for-local-development@rabbitmq:5672
