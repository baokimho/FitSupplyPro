generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model OutboxEvent {
  id               String @id @default(uuid())
  eventId          String @unique
  deduplicationKey String @unique
  payload          String
  createdAt        DateTime @default(now())
  publishedAt      DateTime?
  attempts         Int @default(0)
  lastError        String?
  nextAttemptAt    DateTime @default(now())

  @@index([publishedAt, nextAttemptAt, createdAt])
}

model CheckoutEvent {
  eventId     String @id
  fingerprint String
  result      String?
}

enum CheckoutSagaState {
  RESERVING
  PAYING
  CONFIRMING
  REFUNDING
  RELEASING
  COMPLETED
  CANCELLED
  COMPENSATED
  FAILED
}

model CheckoutSaga {
  id                    String @id @default(uuid())
  orderId               String @unique
  order                 Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  state                 CheckoutSagaState @default(RESERVING)
  correlationId         String
  inventoryReserved     Boolean @default(false)
  inventoryReleased     Boolean @default(false)
  paymentId             String?
  paymentEventId        String?
  paymentEventFingerprint String?
  paymentOutcome        String?
  failureCode           String?
  failedStep            String?
  compensationError     String?
  compensationRetryable Boolean?
  lastEventId           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([state, updatedAt])
}

model Order {
  checkoutSaga CheckoutSaga?
  eventDriven Boolean @default(false)
  creationEvent String?
  id          String      @id @default(uuid())
  userId      String
  status      OrderStatus @default(PENDING)
  pendingStatus OrderStatus?
  reservationConsumed Boolean @default(false)
  totalAmount Decimal     @db.Decimal(10, 2)
  recipientName String?
  contactPhone String?
  deliveryAddressLine1 String?
  deliveryAddressLine2 String?
  deliveryCity String?
  deliveryRegion String?
  deliveryPostalCode String?
  deliveryCountryCode String?

  items       OrderItem[]
  idempotencyAttempts CheckoutIdempotency[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  productSlug String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@unique([orderId, productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model CheckoutIdempotency {
  id                 String   @id @default(uuid())
  userId             String
  idempotencyKey     String
  requestFingerprint String
  status             String
  orderId            String?
  responseBody       Json?
  reservedItems      Json?
  compensationError  String?
  finalizationCart  Json?
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  order              Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([orderId])
}




