generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model OutboxEvent {
  id               String    @id @default(uuid())
  eventId          String    @unique
  deduplicationKey String    @unique
  payload          String
  traceparent      String?
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?
  attempts         Int       @default(0)
  lastError        String?
  nextAttemptAt    DateTime  @default(now())

  @@index([publishedAt, nextAttemptAt, createdAt])
}

model ConsumerDelivery {
  consumer    String
  messageKey  String
  replayCount Int      @default(0)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([consumer, messageKey, replayCount])
}

model CheckoutEvent {
  eventId     String   @id
  eventType   String?
  processedAt DateTime @default(now())
  fingerprint String
  result      String?
}

model Inventory {
  id                String   @id @default(uuid())
  productId         String   @unique
  stock             Int      @default(0)
  reservedStock     Int      @default(0)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  operations InventoryOperation[]
}

model InventoryOperation {
  id          String   @id @default(uuid())
  operationId String   @unique
  productId   String
  type        String
  quantity    Int
  createdAt   DateTime @default(now())

  inventory Inventory @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@index([productId])
}
