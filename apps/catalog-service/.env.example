# Development Compose example. See README Configuration for host overrides.
# Runtime (optional; values shown are defaults)
NODE_ENV=development
LOG_LEVEL=info
PORT=3002

# Database (required; local credentials only)
DATABASE_URL=postgresql://fitsupply:change-me-for-local-development@postgres:5432/catalog_db
# Optional Prisma tooling only; omit unless using a separate shadow database.
# SHADOW_DATABASE_URL=postgresql://fitsupply:change-me-for-local-development@postgres:5432/catalog_shadow_db

# Internal authentication (required; must match communicating services)
GATEWAY_SECRET=change-me-for-local-development
