@baseUrl = http://localhost:3001
@gatewayBaseUrl = http://localhost:3000
@catalogBaseUrl = http://localhost:3002
@orderBaseUrl = http://localhost:3003
@contentType = application/json

### Register via gateway
POST {{gatewayBaseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "customer123e@example.com",
  "password": "Password123!",
  "name": "Customer123 One"
}

### Login via gateway
# @name login
POST {{gatewayBaseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "customer123e@example.com",
  "password": "Password123!"
}

###

@accessToken = {{login.response.body.accessToken}}
@refreshToken = {{login.response.body.refreshToken}}

### Refresh token via gateway
POST {{gatewayBaseUrl}}/auth/refresh-token
Content-Type: {{contentType}}

{
  "refreshToken": "{{refreshToken}}"
}

### Get JWKS via gateway
GET {{gatewayBaseUrl}}/auth/jwks

### Logout via gateway
POST {{gatewayBaseUrl}}/auth/logout
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "refreshToken": "{{refreshToken}}"
}

### Gateway smoke test - auth routes
POST {{gatewayBaseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "gateway.customer123e@example.com",
  "password": "Password123!",
  "name": "Gateway Customer"
}

###

# @name gatewayLogin
POST {{gatewayBaseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "gateway.customer123e@example.com",
  "password": "Password123!"
}

###

@gatewayAccessToken = {{gatewayLogin.response.body.accessToken}}
@gatewayRefreshToken = {{gatewayLogin.response.body.refreshToken}}

###
GET {{gatewayBaseUrl}}/auth/jwks

###
GET {{gatewayBaseUrl}}/auth/me
Authorization: Bearer {{gatewayAccessToken}}

###
POST {{gatewayBaseUrl}}/auth/refresh-token
Content-Type: {{contentType}}

{
  "refreshToken": "{{gatewayRefreshToken}}"
}

###
POST {{gatewayBaseUrl}}/auth/logout
Content-Type: {{contentType}}
Authorization: Bearer {{gatewayAccessToken}}

{
  "refreshToken": "{{gatewayRefreshToken}}"
}

### Gateway smoke test - service routes
GET {{gatewayBaseUrl}}/catalog/health
Authorization: Bearer {{gatewayAccessToken}}

###
GET {{gatewayBaseUrl}}/order/health
Authorization: Bearer {{gatewayAccessToken}}

### Prevent gateway bypass - direct service calls should fail
GET {{baseUrl}}/health

###
GET {{baseUrl}}/jwks

###
GET {{catalogBaseUrl}}/health

###
GET {{orderBaseUrl}}/health