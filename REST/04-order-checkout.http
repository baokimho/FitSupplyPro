@gatewayBaseUrl = http://localhost:3000
@contentType = application/json
@email = rest-client-user@example.com
@password = Password123!
@productId = catalog-product-id
@cartItemId = cart-item-id
@adminAccessToken = replace-with-admin-access-token

### Login
# @name loginUser
POST {{gatewayBaseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

@accessToken = {{loginUser.response.body.accessToken}}

### Create order
# @name createOrder
POST {{gatewayBaseUrl}}/order/orders
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "items": [
    {
      "productId": "{{productId}}",
      "quantity": 1
    }
  ],
  "delivery": {
    "recipientName": "Test Customer",
    "contactPhone": "+358 40 1234567",
    "addressLine1": "Testikatu 1",
    "city": "Helsinki",
    "postalCode": "00100",
    "countryCode": "FI"
  }
}

###

@orderId = {{createOrder.response.body.id}}

### My orders
GET {{gatewayBaseUrl}}/order/orders/me
Authorization: Bearer {{accessToken}}

### Get order by id
GET {{gatewayBaseUrl}}/order/orders/{{orderId}}
Authorization: Bearer {{accessToken}}

### Confirm order (ADMIN; reservation retained)
PATCH {{gatewayBaseUrl}}/order/orders/{{orderId}}/confirm
Authorization: Bearer {{adminAccessToken}}

### Process order (ADMIN; consumes reservation)
PATCH {{gatewayBaseUrl}}/order/orders/{{orderId}}/process
Authorization: Bearer {{adminAccessToken}}

### Ship order (ADMIN; requires PROCESSING)
PATCH {{gatewayBaseUrl}}/order/orders/{{orderId}}/ship
Authorization: Bearer {{adminAccessToken}}

### Deliver order (ADMIN; requires SHIPPED)
PATCH {{gatewayBaseUrl}}/order/orders/{{orderId}}/deliver
Authorization: Bearer {{adminAccessToken}}

### Cancel own order (PENDING/CONFIRMED only; after processing returns 409)
PATCH {{gatewayBaseUrl}}/order/orders/{{orderId}}/cancel
Authorization: Bearer {{accessToken}}

### Checkout selected cart items
POST {{gatewayBaseUrl}}/order/orders/checkout
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}
Idempotency-Key: rest-checkout-1

{
  "cartItemIds": ["{{cartItemId}}"],
  "delivery": {
    "recipientName": "Test Customer",
    "contactPhone": "+358 40 1234567",
    "addressLine1": "Testikatu 1",
    "city": "Helsinki",
    "postalCode": "00100",
    "countryCode": "FI"
  }
}
