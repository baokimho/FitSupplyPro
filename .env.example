# Broker clients run on host; Compose clients use rabbitmq instead of localhost.
# Order, Inventory and Payment require these values when Phase 7 is enabled.
EVENT_DRIVEN_CHECKOUT=false
RABBITMQ_URL=amqp://fitsupply:change-me-for-local-development@localhost:5672
RABBITMQ_CONNECTION_TIMEOUT_MS=3000

# Phase 11: set in each caller's apps/<service>/.env for development Compose.
# Root values also configure docker-compose.test.yml. Milliseconds: 1..60000.
DEPENDENCY_TIMEOUT_MS=2500
# Attempts: 1..5, including initial call. Only eligible operations retry.
DEPENDENCY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=100
RETRY_MAX_DELAY_MS=1000
PROXY_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=2500
DB_STATEMENT_TIMEOUT_MS=5000

# Phase 13: set in apps/api-gateway/.env for development Compose.
# Fixed upstream origins only (no credentials, paths, query or fragment).
# Production requires all eight *_SERVICE_URL values and CORS_ALLOWED_ORIGINS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
GATEWAY_BODY_LIMIT_BYTES=1048576
GATEWAY_RATE_WINDOW_MS=60000
GATEWAY_RATE_LIMIT=600
GATEWAY_AUTH_RATE_LIMIT=5
GATEWAY_REFRESH_RATE_LIMIT=30
# Gateway trusts socket IP only. No client-controlled forwarding headers trusted.

# Phase 14: same JWT contract in Auth and Gateway. TTLs in seconds.
JWT_ISSUER=fitsupply-auth-service
JWT_AUDIENCE=fitsupply-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_CLOCK_TOLERANCE_SECONDS=5
JWKS_CACHE_TTL_MS=60000
JWKS_STALE_MS=300000
JWKS_REFRESH_COOLDOWN_MS=10000
# Auth only: optional runtime keyring file. Mount its directory for atomic swaps.
# JWT_KEYRING_FILE=/app/keys/keyring.json
JWT_KEY_RELOAD_MS=5000
# Existing JWT_PRIVATE_KEY_BASE64/JWT_PUBLIC_KEY_BASE64 or keys/*.json remain
# supported without a keyring. Never place private material in Gateway config.

# Phase 15: set in EACH service environment (or its development Compose env_file).
# Optional OTLP HTTP/JSON trace endpoint. Empty disables export, keeps propagation.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Root sampling ratio 0..1. Remote parent sampling decision is respected.
OTEL_TRACES_SAMPLER_ARG=1
# GET /metrics requires x-internal-secret: GATEWAY_SECRET on every service.
# Gateway blocks downstream /metrics paths; scrape services directly on private network.
